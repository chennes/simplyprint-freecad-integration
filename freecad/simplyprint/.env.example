# SimplyPrint FreeCAD addon configuration
# Copy this file to .env (same directory) or ~/.simplyprint/.env

# Backend domain (default: simplyprint.io)
# SP_BASE_DOMAIN=test.simplyprint.io

# OAuth client ID (default: simplyprintfreecad)
# SP_CLIENT_ID=simplyprintfreecad

# Local OAuth callback port (default: 21331)
# SP_CALLBACK_PORT=21331
